        "readOnly": true
      },
      {
        "name": "slack.slack_send_message",
        "permission": "slack_slack_send_message",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_send_message_draft",
        "permission": "slack_slack_send_message_draft",
        "effect": "allow",
