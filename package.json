        "readOnly": false
      },
      {
        "name": "slack.slack_update_canvas",
        "permission": "slack_slack_update_canvas",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_add_reaction",
        "permission": "slack_slack_add_reaction",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_get_file_upload_url",
        "permission": "slack_slack_get_file_upload_url",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_complete_file_upload",
        "permission": "slack_slack_complete_file_upload",
        "effect": "allow",
        "readOnly": false
