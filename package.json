        "permission": "slack_slack_update_list_record",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "slack-search"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "app",
        "label": "Slack app client ID",
        "integration": "slack-app",
        "presetBy": "oauth.client_id",
        "hostClient": {
          "id": "slack",
          "option": "oauth.client_id"
        },
        "help": {
          "url": "https://github.com/joe-broadhead/opencode-slack/blob/HEAD/docs/slack-app-manifest.json",
          "label": "Create the Slack app from its manifest, then paste its client ID"
        }
      },
      {
        "id": "slack",
        "label": "Slack",
        "server": "slack",
        "after": "app",
        "relay": {}
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule."
        }
      ]
    }
  }
}
