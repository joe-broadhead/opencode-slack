{
  "name": "@joe-broadhead/opencode-slack",
  "version": "0.0.0",
  "description": "Unofficial OpenCode plugin for Slack",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "slack"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-slack.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-slack#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-slack/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "slack",
      "name": "Slack",
      "domain": "slack.com"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test/unit",
    "test:kit": "node --test scripts/release-kit.test.mjs",
    "test:tui": "bun test test/tui",
    "test:host": "bun test test/host",
    "test:pack": "bun test test/pack",
    "drift": "bun scripts/drift.ts",
    "check": "npm run typecheck && node scripts/check-copies.mjs && npm run build && npm test && npm run test:kit && npm run test:tui && npm run test:host && npm run test:pack && npm run icons && npm run actionlint",
    "icons": "node scripts/check-icons.mjs",
    "actionlint": "node scripts/check-actionlint.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/util": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.3",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  },
  "jelly": {
    "title": "Slack",
    "summary": "Your Slack messages, channels, canvases and files.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "slack.slack_search_public",
        "permission": "slack_slack_search_public",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_search_channels",
        "permission": "slack_slack_search_channels",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_search_users",
        "permission": "slack_slack_search_users",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_channel",
        "permission": "slack_slack_read_channel",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_thread",
        "permission": "slack_slack_read_thread",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_user_profile",
        "permission": "slack_slack_read_user_profile",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_canvas",
        "permission": "slack_slack_read_canvas",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_list_channel_members",
        "permission": "slack_slack_list_channel_members",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_get_reactions",
        "permission": "slack_slack_get_reactions",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_list_user_channels",
        "permission": "slack_slack_list_user_channels",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_list",
        "permission": "slack_slack_read_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_search_emojis",
        "permission": "slack_slack_search_emojis",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.events_list",
        "permission": "slack_events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_search_public_and_private",
        "permission": "slack_slack_search_public_and_private",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_file",
        "permission": "slack_slack_read_file",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_send_message",
        "permission": "slack_slack_send_message",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_send_message_draft",
        "permission": "slack_slack_send_message_draft",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_schedule_message",
        "permission": "slack_slack_schedule_message",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "slack.slack_create_canvas",
        "permission": "slack_slack_create_canvas",
