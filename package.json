        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_user_profile",
        "permission": "slack_slack_read_user_profile",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_read_canvas",
        "permission": "slack_slack_read_canvas",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "slack.slack_list_channel_members",
